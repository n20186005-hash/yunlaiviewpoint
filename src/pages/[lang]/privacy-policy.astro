---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { languagesList, getI18n } from '../../i18n/ui';

export function getStaticPaths() {
  return languagesList.map((lang) => ({ params: { lang } }));
}
const { lang, messages } = await getI18n(Astro.url);
const legal = messages.legal.privacy;
---
<BaseLayout lang={lang} title={`${legal.title} | ${messages.meta.title}`} description={legal.title} messages={messages} path="privacy-policy">
  <Header lang={lang} messages={messages} />
  <main class="min-h-screen bg-ivory pt-28 pb-20">
    <article class="mx-auto max-w-3xl px-5 text-ink/85 leading-relaxed">
      <h1 class="font-display text-3xl md:text-4xl text-teak">{legal.title}</h1>
      <p class="mt-3 text-sm text-ink/60">{legal.updated}</p>
      <div class="mt-10 space-y-9">
        {legal.sections.map((section: { h: string; p: string }) => (
          <section>
            <h2 class="font-display text-xl text-teak mb-3">{section.h}</h2>
            <p>{section.p}</p>
          </section>
        ))}
      </div>
    </article>
  </main>
  <Footer lang={lang} messages={messages} />
</BaseLayout>
