---
interface Props {
  messages: Record<string, any>;
}
const { messages } = Astro.props;
const s = messages.sunrise;
---

<section id="sunrise" class="py-20 bg-ivory text-ink">
  <div class="max-w-7xl mx-auto px-5">
    <p class="font-hand text-gold text-xl md:text-2xl">{s.label}</p>
    <h2 class="font-display font-semibold text-3xl md:text-5xl text-teak mt-2">{s.heading}</h2>
    <p class="mt-4 max-w-3xl text-ink/80">{s.intro}</p>

    <!-- 云海最佳月份 -->
    <h3 class="font-display text-2xl text-teak mt-12 mb-5">{s.monthsTitle}</h3>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {s.months.map((m) => (
        <div class="rounded-2xl border border-gold/30 bg-white/50 p-5">
          <div class="flex items-center justify-between">
            <span class="font-display text-gold text-xl">{m.tag}</span>
            <span class="text-xs text-teak font-medium bg-gold/15 px-2 py-1 rounded-full">{m.months}</span>
          </div>
          <h4 class="font-display text-teak font-semibold text-lg mt-2">{m.name}</h4>
          <p class="mt-1 text-sm text-ink/75">{m.desc}</p>
        </div>
      ))}
    </div>

    <!-- 云海形成条件 -->
    <div class="mt-14 grid lg:grid-cols-2 gap-10">
      <div>
        <h3 class="font-display text-2xl text-teak mb-5">{s.conditionsTitle}</h3>
        <div class="space-y-3">
          {s.conditions.map((c) => (
            <div class="rounded-xl border border-gold/25 bg-white/50 p-4">
              <div class="font-semibold text-teak">{c.title}</div>
              <p class="mt-1 text-sm text-ink/70">{c.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- 清晨时间线 -->
      <div>
        <h3 class="font-display text-2xl text-teak mb-5">{s.timelineTitle}</h3>
        <ol class="relative border-l-2 border-gold/40 pl-6 space-y-6">
          {s.timeline.map((t) => (
            <li class="relative">
              <span class="absolute -left-[31px] top-1 h-3 w-3 rounded-full bg-gold" aria-hidden="true"></span>
              <div class="font-display font-semibold text-teak">
                <span class="text-gold">{t.time}</span> · {t.title}
              </div>
              <p class="mt-1 text-sm text-ink/75">{t.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>

    <!-- 推荐机位 -->
    <h3 class="font-display text-2xl text-teak mt-14 mb-5">{s.spotsTitle}</h3>
    <div class="grid sm:grid-cols-3 gap-4">
      {s.spots.map((p) => (
        <div class="rounded-2xl border border-gold/25 bg-white/50 p-5">
          <div class="font-display text-teak font-semibold text-lg">{p.name}</div>
          <p class="mt-1 text-sm text-ink/70">{p.desc}</p>
        </div>
      ))}
    </div>

    <!-- 随身物品 -->
    <div class="mt-14 rounded-2xl border border-teal-300 bg-teal-50 p-6 max-w-4xl shadow-sm">
      <h3 class="font-display text-xl text-teal-800">{s.bringTitle}</h3>
      <ul class="mt-3 grid sm:grid-cols-2 gap-2 text-sm text-teal-900/85">
        {s.bring.map((b) => (
          <li class="flex gap-2">
            <span class="text-teal-600 mt-0.5" aria-hidden="true">✓</span>
            <span>{b}</span>
          </li>
        ))}
      </ul>
    </div>

    <p class="mt-8 max-w-3xl text-xs text-ink/55 leading-relaxed border-l-2 border-gold/40 pl-3">{s.note}</p>
  </div>
</section>
