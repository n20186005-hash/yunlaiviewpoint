---
import { guides, guideLabels } from '../data/guides';
import { places } from '../data/places';
import type { Lang } from '../i18n/ui';
const { lang } = Astro.props as { lang: Lang };
const labels = guideLabels[lang];
---
<section id="explore" class="py-20 bg-teakDeep text-ivory">
  <div class="max-w-7xl mx-auto px-5">
    <p class="text-gold uppercase tracking-widest text-sm mb-3">Explore Pai</p>
    <h2 class="font-display text-3xl md:text-4xl text-goldBright mb-3">{labels.heading}</h2>
    <p class="text-ivory/70 mb-9">{labels.subtitle}</p>
    <div class="grid md:grid-cols-3 gap-5">
      {guides.map((guide: any, i: number) => <a href={`/${lang}/guides/${guide.slug}/`} class="block rounded-2xl border border-gold/20 bg-teak/80 p-7 hover:border-gold transition-colors">
        <span class="text-gold text-sm">0{i + 1} / Pai Guide</span>
        <h3 class="font-display text-xl text-goldBright mt-3 mb-3">{guide.name[lang]}</h3>
        <p class="text-sm text-ivory/70 leading-relaxed">{guide.copy[lang].intro}</p>
        <span class="inline-block mt-5 text-goldBright">{lang === 'th' ? 'อ่านคู่มือ →' : lang === 'zh' ? '阅读指南 →' : 'Read guide →'}</span>
      </a>)}
    </div>
    <h3 class="font-display text-2xl text-goldBright mt-12 mb-6">{lang === 'zh' ? '周边景点深度游览' : lang === 'th' ? 'เจาะลึกสถานที่ใกล้เคียง' : 'Explore nearby places'}</h3>
    <div class="grid md:grid-cols-3 gap-5">
      {places.map(place => <a href={`/${lang}/places/${place.slug}/`} class="rounded-2xl overflow-hidden bg-teak border border-gold/20 hover:border-gold transition-colors block">
        <img src={place.image} alt={place.local[lang].title} width="960" height="720" loading="lazy" class="w-full aspect-[16/10] object-cover" />
        <div class="p-5"><h4 class="font-display text-lg text-goldBright">{place.local[lang].title}</h4><p class="mt-2 text-sm text-ivory/70">{place.local[lang].tagline}</p></div>
      </a>)}
    </div>
  </div>
</section>
