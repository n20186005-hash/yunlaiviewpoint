---
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  messages: Record<string, any>;
}
const { lang } = Astro.props;
const name = lang === 'th' ? 'จุดชมวิวหยุนไหล' : lang === 'zh' ? '云来观景台' : 'Yun Lai Viewpoint';
const copyrightLabel = lang === 'th' ? 'สงวนลิขสิทธิ์' : lang === 'zh' ? '版权所有' : 'All rights reserved';
const disclaimer = lang === 'th'
  ? 'เว็บไซต์นี้เป็นโครงการข้อมูลท่องเที่ยวอิสระ ไม่มีความเกี่ยวข้องกับหน่วยงานรัฐหรือองค์กรทางการใด ๆ'
  : lang === 'zh'
    ? '本网站是一个独立的旅游信息项目。我们与任何政府机构或官方组织均无关联。'
    : 'This website is an independent travel information project. We are not affiliated with any government agency or official organization.';
---

<footer class="bg-teakDeep text-ivory py-8 border-t border-gold/20">
  <div class="max-w-7xl mx-auto px-5 text-center text-sm text-ivory/70 space-y-2">
    <p>© 2026 {name} · {copyrightLabel}</p>
    <p>{disclaimer}</p>
  </div>
</footer>
