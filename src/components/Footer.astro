---
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  messages: Record<string, any>;
}
const { lang, messages } = Astro.props;
const name = lang === 'th' ? 'จุดชมวิวหยุนไหล' : lang === 'zh' ? '云来观景台' : 'Yun Lai Viewpoint';
const copyrightLabel = lang === 'th' ? 'สงวนลิขสิทธิ์' : lang === 'zh' ? '版权所有' : 'All rights reserved';
const disclaimer = lang === 'th'
  ? 'เว็บไซต์นี้เป็นโครงการข้อมูลท่องเที่ยวอิสระ ไม่มีความเกี่ยวข้องกับหน่วยงานรัฐหรือองค์กรทางการใด ๆ'
  : lang === 'zh'
    ? '本网站是一个独立的旅游信息项目。我们与任何政府机构或官方组织均无关联。'
    : 'This website is an independent travel information project. We are not affiliated with any government agency or official organization.';
---

<footer class="bg-teakDeep text-ivory py-8 border-t border-gold/20">
  <div class="max-w-7xl mx-auto px-5 text-sm text-ivory/70">
    <nav aria-label={lang === 'zh' ? '法律与隐私' : lang === 'th' ? 'นโยบายเว็บไซต์' : 'Legal and privacy'} class="flex flex-wrap items-center justify-center md:justify-end gap-x-5 gap-y-2 mb-6 text-xs">
      <a href={`/${lang}/privacy-policy/`} class="hover:text-goldBright hover:underline">{messages.footer.privacy}</a>
      <a href={`/${lang}/terms-of-service/`} class="hover:text-goldBright hover:underline">{messages.footer.terms}</a>
      <a href={`/${lang}/cookie-settings/`} class="hover:text-goldBright hover:underline">{messages.footer.cookies}</a>
    </nav>
    <div class="text-center space-y-2">
      <p>© 2026 {name} · {copyrightLabel}</p>
      <p>{disclaimer}</p>
    </div>
  </div>
</footer>
