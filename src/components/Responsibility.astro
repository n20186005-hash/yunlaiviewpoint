---
interface Props {
  messages: Record<string, any>;
}
const { messages } = Astro.props;
const r = messages.responsibility;
---
<!--
  科普与访客责任
  先解释景观背后的科学，再说明对访客的行为期待——科普站的核心内容板块。
-->
<section id="responsibility" class="py-20 bg-ivory text-ink">
  <div class="max-w-7xl mx-auto px-5">
    <p class="font-hand text-gold text-xl md:text-2xl">{r.label}</p>
    <h2 class="font-display font-semibold text-3xl md:text-5xl text-teak mt-2">{r.heading}</h2>
    <p class="mt-4 max-w-3xl text-ink/80">{r.intro}</p>

    <!-- 云海背后的科学 -->
    <div class="mt-12">
      <h3 class="font-display text-2xl text-teak">{r.scienceTitle}</h3>
      <p class="mt-2 max-w-3xl text-ink/75">{r.scienceLead}</p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 mt-6">
        {r.science.map((item, i) => (
          <article class="rounded-2xl border border-gold/40 bg-white/65 p-5 flex flex-col">
            <span class="font-display text-gold text-sm">{String(i + 1).padStart(2, '0')}</span>
            <h4 class="mt-1 font-semibold text-teak">{item.title}</h4>
            <p class="mt-2 text-sm text-ink/75 leading-relaxed">{item.text}</p>
          </article>
        ))}
      </div>
    </div>

    <!-- 为什么这道山脊重要 -->
    <div class="mt-12 rounded-3xl bg-teak text-ivory p-6 md:p-10">
      <h3 class="font-display text-2xl text-goldBright">{r.ecosystemTitle}</h3>
      <div class="grid sm:grid-cols-2 gap-6 mt-6">
        {r.ecosystem.map((item) => (
          <div class="border-l-2 border-gold/50 pl-4">
            <h4 class="font-semibold text-ivory">{item.title}</h4>
            <p class="mt-1 text-sm text-ivory/80 leading-relaxed">{item.text}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- 对访客的期待 -->
    <div class="mt-12">
      <h3 class="font-display text-2xl text-teak">{r.dutyTitle}</h3>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 mt-6">
        {r.duties.map((d) => (
          <div class="rounded-2xl bg-white/70 border border-gold/40 p-5 flex items-start gap-3">
            <span class="text-2xl leading-none" aria-hidden="true">{d.icon}</span>
            <div>
              <h4 class="font-semibold text-teak">{d.title}</h4>
              <p class="mt-1 text-sm text-ink/75 leading-relaxed">{d.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- 尊重当地社区 + 安全提示 -->
    <div class="grid lg:grid-cols-2 gap-6 mt-12">
      <div class="rounded-3xl border border-gold/45 bg-gradient-to-br from-gold/15 to-white/60 p-6 md:p-8">
        <h3 class="font-display text-2xl text-teak">{r.cultureTitle}</h3>
        <p class="mt-3 text-ink/80 leading-relaxed">{r.cultureText}</p>
      </div>
      <div class="rounded-3xl border border-burgundy/30 bg-burgundy/5 p-6 md:p-8">
        <h3 class="font-display text-2xl text-burgundy">{r.safetyTitle}</h3>
        <ul class="mt-3 space-y-2.5">
          {r.safety.map((line: string) => (
            <li class="flex items-start gap-2.5 text-sm text-ink/80">
              <span class="text-burgundy mt-0.5" aria-hidden="true">▲</span>
              <span>{line}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- 这份指南为何存在 -->
    <div class="mt-12 text-center">
      <div class="ornament mx-auto" />
      <h3 class="mt-6 font-display text-xl text-teak">{r.closingTitle}</h3>
      <p class="mt-2 max-w-2xl mx-auto text-sm text-ink/70 leading-relaxed">{r.closingText}</p>
    </div>
  </div>
</section>
